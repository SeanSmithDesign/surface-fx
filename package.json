{
  "name": "@seansmith/surface-fx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-forward dither/ripple/pointer surface-effect library for React. Pure-logic foundation, zero coupling to any design system.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=19",
    "motion": ">=12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.7",
    "react": "19.2.7",
    "@types/react": "^19",
    "@types/node": "^22",
    "motion": "^12.40.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fx": "node scripts/surface-fx.mjs",
    "fx:ui": "node scripts/surface-fx-ui.mjs",
    "fx:mcp": "node scripts/surface-fx-mcp.mjs"
  }
}
